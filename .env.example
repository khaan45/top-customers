# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=4000
# Comma-separated list of origins allowed to call this API (your portal's real domain(s))
ALLOWED_ORIGINS=https://your-portal.example.com

# ---- Voting window (server is the source of truth, not the browser) ----
VOTING_START=2026-08-06T00:00:00Z
VOTING_END=2026-08-26T23:59:00Z

# ---- Campus location (voters must be physically near this to vote) ----
# Get coordinates from Google Maps: right-click your campus center, the
# lat,lng shown at the top of the menu is what you want. Radius should
# cover the whole campus plus margin for GPS inaccuracy (phone GPS is
# commonly off by 10-50m, more indoors) — too tight will block real voters.
# NOTE: this is a deterrent, not foolproof — GPS coordinates sent from a
# browser can be spoofed by a determined person. Treat it as one layer,
# not the only defense.
CAMPUS_LAT=0
CAMPUS_LNG=0
CAMPUS_RADIUS_METERS=800

# ---- Database (Neon Postgres — free, permanent, no credit card required) ----
# Sign up at neon.tech (no card needed), create a project, and copy the
# "Connection string" it gives you — looks like:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Paste that whole thing here. Tables are created automatically on first
# startup (see init() in db.js) — you don't need to run any SQL by hand.
DATABASE_URL=

# ---- OTP delivery: WhatsApp ----
# Uses Meta's WhatsApp Cloud API directly (no paid reseller needed). Get
# these from Meta for Developers > your app > WhatsApp > API Setup:
#   WHATSAPP_TOKEN            temporary token shown there (swap for a
#                              permanent token before going live — see README)
#   WHATSAPP_PHONE_NUMBER_ID  the "Phone number ID" shown on that same page
# You also need an approved "Authentication" category message template —
# see README for how to create one. Until these are filled in, sendWhatsAppOtp()
# throws instead of pretending to send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=en_US

# ---- OTP delivery: SMS (fallback / alternative channel) ----
# The voter picks WhatsApp or SMS on the form — this is what powers the SMS
# option. Start with SMS_PROVIDER=console to test locally without a real
# SMS account (prints the code to your terminal instead of texting it).
SMS_PROVIDER=console
# Fill in whichever provider you actually have a contract with.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
# Generic fallback provider (used if SMS_PROVIDER=generic_http)
GENERIC_SMS_URL=
GENERIC_SMS_API_KEY=

# ---- Security ----
# Long random string used to sign short-lived vote-session tokens issued after OTP success
SESSION_SECRET=change-this-to-a-long-random-string
# How long an OTP is valid for, in seconds
OTP_TTL_SECONDS=300
# How long a verified session token is valid for (time to actually cast the vote), in seconds
SESSION_TTL_SECONDS=600
# Required to use GET /api/admin/audit-log — generate with `openssl rand -hex 24`.
# Send it as the X-Admin-Key header. Leave blank and the endpoint stays disabled.
ADMIN_API_KEY=
