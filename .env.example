# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=4000
# Comma-separated list of origins allowed to call this API (your portal's real domain(s))
ALLOWED_ORIGINS=https://your-portal.example.com

# ---- Voting window (server is the source of truth, not the browser) ----
VOTING_START=2026-08-06T00:00:00Z
VOTING_END=2026-08-26T23:59:00Z

# ---- Student / customer database ----
# Point this at your REAL student or customer database (could be the same DB
# behind your Zaad/eDahab transaction records). This scaffold ships with a
# local SQLite file (students.db) pre-seeded with a couple of fake rows so
# you can test the flow — swap studentLookup() in db.js for a real query
# against your actual system when you're ready.
STUDENT_DB_PATH=./data/students.db

# ---- SMS delivery ----
# Firebase Phone Auth sends the OTP itself (Google's infrastructure), so this
# backend no longer needs its own SMS gateway or provider credentials.

# ---- Firebase Admin (verifies the phone-auth token the frontend gets) ----
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Save the downloaded JSON file somewhere OUTSIDE your web root
# and point this at it. Never commit this file or expose it to the frontend —
# it's the one credential in this whole setup that must stay backend-only.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ---- Security ----
# Long random string used to sign short-lived vote-session tokens issued after OTP success
SESSION_SECRET=change-this-to-a-long-random-string
# How long a verified session token is valid for (time to actually cast the vote), in seconds
SESSION_TTL_SECONDS=600
