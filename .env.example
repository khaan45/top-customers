# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=4000
# Comma-separated list of origins allowed to call this API (your portal's real domain(s))
ALLOWED_ORIGINS=https://your-portal.example.com

# ---- Voting window (server is the source of truth, not the browser) ----
VOTING_START=2026-08-06T00:00:00Z
VOTING_END=2026-08-26T23:59:00Z

# ---- Student / customer database ----
# Point this at your REAL student or customer database (could be the same DB
# behind your Zaad/eDahab transaction records). This scaffold ships with a
# local SQLite file (students.db) pre-seeded with a couple of fake rows so
# you can test the flow — swap studentLookup() in db.js for a real query
# against your actual system when you're ready.
STUDENT_DB_PATH=./data/students.db

# ---- OTP delivery: WhatsApp ----
# Uses Meta's WhatsApp Cloud API directly (no paid reseller needed). Get
# these from Meta for Developers > your app > WhatsApp > API Setup:
#   WHATSAPP_TOKEN            temporary token shown there (swap for a
#                              permanent token before going live — see README)
#   WHATSAPP_PHONE_NUMBER_ID  the "Phone number ID" shown on that same page
# You also need an approved "Authentication" category message template —
# see README for how to create one. Until these are filled in, sendWhatsAppOtp()
# throws instead of pretending to send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=en_US

# ---- OTP delivery: SMS (fallback / alternative channel) ----
# The voter picks WhatsApp or SMS on the form — this is what powers the SMS
# option. Start with SMS_PROVIDER=console to test locally without a real
# SMS account (prints the code to your terminal instead of texting it).
SMS_PROVIDER=console
# Fill in whichever provider you actually have a contract with.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
# Generic fallback provider (used if SMS_PROVIDER=generic_http)
GENERIC_SMS_URL=
GENERIC_SMS_API_KEY=

# ---- Security ----
# Long random string used to sign short-lived vote-session tokens issued after OTP success
SESSION_SECRET=change-this-to-a-long-random-string
# How long an OTP is valid for, in seconds
OTP_TTL_SECONDS=300
# How long a verified session token is valid for (time to actually cast the vote), in seconds
SESSION_TTL_SECONDS=600
